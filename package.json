{
  "name": "restaurant-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:architecture && corepack pnpm contracts:lint && corepack pnpm build",
    "contracts:lint": "redocly lint docs/contracts/openapi.yaml && tsx scripts/validate-events.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "corepack pnpm --parallel --filter @rms/api --filter @rms/worker --filter @rms/staff-web dev",
    "dev:api": "corepack pnpm --filter @rms/api dev",
    "dev:staff": "corepack pnpm --filter @rms/staff-web dev",
    "dev:worker": "corepack pnpm --filter @rms/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:architecture": "dependency-cruiser --config dependency-cruiser.config.cjs apps packages && vitest run tests/architecture",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.41.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/parser": "8.65.0",
    "dependency-cruiser": "18.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
