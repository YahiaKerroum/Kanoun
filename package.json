{
  "name": "restaurant-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build && corepack pnpm test:pd025:production-boundary",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:architecture && corepack pnpm contracts:lint && corepack pnpm build && corepack pnpm test:frontend:diagnostics",
    "contracts:lint": "redocly lint docs/contracts/openapi.yaml && tsx scripts/validate-events.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "corepack pnpm build && tsx scripts/seed-demo.ts",
    "db:setup:demo": "docker compose up -d postgres && corepack pnpm db:seed:demo",
    "dev": "corepack pnpm --parallel --filter @rms/api --filter @rms/worker --filter @rms/staff-web dev",
    "dev:api": "corepack pnpm --filter @rms/api dev",
    "dev:demo": "corepack pnpm build && tsx scripts/dev-demo.ts",
    "dev:staff": "corepack pnpm --filter @rms/staff-web dev",
    "dev:worker": "corepack pnpm --filter @rms/worker dev",
    "demo:contexts": "tsx scripts/demo-contexts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "react:doctor": "react-doctor --no-telemetry --blocking error",
    "react:grab": "grab pull",
    "react:scan:staff": "corepack pnpm --filter @rms/staff-web dev",
    "test": "vitest run --passWithNoTests",
    "test:architecture": "dependency-cruiser --config dependency-cruiser.config.cjs apps packages && vitest run tests/architecture",
    "test:browser": "corepack pnpm test:browser:mocked && corepack pnpm test:browser:real",
    "test:browser:mocked": "cross-env VITE_DISABLE_REACT_DIAGNOSTICS=true playwright test --config playwright.mocked.config.ts",
    "test:browser:real": "tsx scripts/test-browser-real.ts",
    "test:frontend:diagnostics": "tsx scripts/assert-frontend-diagnostics-excluded.ts",
    "test:pd025:production-boundary": "tsx scripts/assert-pd025-diagnostic-excluded.ts",
    "lighthouse:median": "tsx scripts/lighthouse-median.ts",
    "test:browser:pr03:real-stack": "playwright test --config playwright.pr03-real-stack.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.41.0",
    "@rms/building-blocks": "workspace:*",
    "@rms/modules": "workspace:*",
    "@rms/service-workflow": "workspace:*",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.65.0",
    "chrome-launcher": "1.2.1",
    "cross-env": "7.0.3",
    "dependency-cruiser": "18.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "grab": "0.1.50",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "react-doctor": "0.9.11",
    "react-grab": "0.1.50",
    "react-scan": "0.5.7",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "undici": "^8.10.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
