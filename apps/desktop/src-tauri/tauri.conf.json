{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MISE",
  "mainBinaryName": "mise",
  "version": "0.2.0",
  "identifier": "app.mise.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "corepack pnpm launcher:dev",
    "beforeBuildCommand": "corepack pnpm launcher:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MISE",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MISE",
    "category": "Business",
    "shortDescription": "Restaurant operations",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mise-node"],
    "resources": {
      "../build/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
