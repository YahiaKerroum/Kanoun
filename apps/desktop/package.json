{
  "name": "@rms/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle-runtime": "corepack pnpm --filter @rms/staff-web --filter @rms/admin-web --filter @rms/customer-web build && node scripts/build-runtime.mjs",
    "launcher:dev": "vite",
    "launcher:build": "vite build",
    "dev": "corepack pnpm bundle-runtime && tauri dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "installer": "corepack pnpm bundle-runtime && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@rms/building-blocks": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.20.0",
    "esbuild": "0.28.2",
    "vite": "8.3.2"
  }
}
