# Copy to .env and replace local placeholders. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
DATABASE_URL=postgresql://rms:rms_local_only@127.0.0.1:5432/rms
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SECRET=replace-with-a-separate-32-character-secret
SESSION_COOKIE_SECURE=false
WEB_ORIGIN=http://127.0.0.1:5175
# Production credential recovery requires both values and an HTTPS delivery adapter.
# RECOVERY_DELIVERY_URL=https://delivery.example.internal/v1/tokens
# RECOVERY_DELIVERY_SECRET=replace-with-at-least-32-random-characters
