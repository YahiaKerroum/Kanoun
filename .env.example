# Copy to .env and replace local placeholders. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
DATABASE_URL=postgresql://rms:rms_local_only@127.0.0.1:5432/rms
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SECRET=replace-with-a-separate-32-character-secret
SUPPORT_ACCESS_SECRET=replace-with-a-third-32-character-secret
GUEST_ACCESS_SECRET=replace-with-a-fourth-32-character-secret
SESSION_COOKIE_SECURE=false
WEB_ORIGIN=http://127.0.0.1:5175
STAFF_WEB_ORIGIN=http://127.0.0.1:5173
CUSTOMER_WEB_ORIGIN=http://127.0.0.1:5174
# Required safety boundary for `corepack pnpm dev:demo`; this command never
# falls back to DATABASE_URL and only accepts the marked loopback database.
DEMO_DATABASE_URL=postgresql://rms:rms_local_only@127.0.0.1:5432/rms_demo
DEMO_DATABASE_NAME=rms_demo
DEMO_DATABASE_MARKER=MISE_LOCAL_SYNTHETIC_DEMO_V1
DEMO_LAUNCHER_HOST=127.0.0.1
DEMO_LAUNCHER_PORT=4170
# Optional. If omitted, a new run-scoped password is generated in memory.
# DEMO_SEED_PASSWORD=choose-a-local-only-password
# Worker identity, lease/retry policy, and processed-event retention.
WORKER_ID=rms-worker-1
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=90
# Production credential recovery requires both values and an HTTPS delivery adapter.
# RECOVERY_DELIVERY_URL=https://delivery.example.internal/v1/tokens
# RECOVERY_DELIVERY_SECRET=replace-with-at-least-32-random-characters
